# MultiHazard-VLM Environment Configuration
# Copy to .env.local for local development

# Database
DATABASE_URL=postgresql://postgres:hazard_password@localhost:5432/hazard_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=hazard_password
POSTGRES_DB=hazard_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=hazard_redis_password
REDIS_DB=0

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true

# Streamlit
STREAMLIT_SERVER_PORT=8503
STREAMLIT_THEME_BASE=dark

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Model
MODEL_VERSION=v2.0
MODEL_DEVICE=cpu

# Cache
PREDICTION_CACHE_TTL=3600
STATS_CACHE_TTL=300

# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000
